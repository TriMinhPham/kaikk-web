# Cloudflare Pages response headers for static assets (not applied to Functions,
# which set their own). Pages already sends X-Content-Type-Options: nosniff and
# Referrer-Policy: strict-origin-when-cross-origin, so they are not repeated here.
#
# CSP allows: Cloudflare Turnstile (contact pages), Cloudflare Web Analytics
# (auto-injected beacon on kaikk.jp), Cloudflare email obfuscation (/cdn-cgi, same
# origin). 'unsafe-inline' scripts are needed by the Next.js static export.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:; object-src 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000

# Content-hashed build output: safe to cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
